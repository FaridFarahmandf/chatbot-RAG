# ==========================================================
#  Configuration — copy this file to ".env" and edit as needed.
#  cp .env.example .env
# ==========================================================

# Which LLM backend to use: "ollama" (local, free) or "groq" (free cloud API).
LLM_BACKEND=ollama

# ---- Ollama (local) settings ----
# Make sure you have installed Ollama and pulled the model:
#   ollama pull llama3.1:8b
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434

# ---- Groq (free cloud) settings ----
# Only needed if LLM_BACKEND=groq.
# Get a free API key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# ---- Embedding model (runs locally, free, no key needed) ----
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---- Retrieval settings ----
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=4

# ---- Paths ----
DATA_DIR=data
VECTOR_STORE_DIR=vector_store
